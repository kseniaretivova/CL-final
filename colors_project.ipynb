   "source": [
    "#Функция для очистки текстов фрагментов\n",
    "def clean_text(text: str) -> str:\n",
    "    text = text.lower()\n",
    "    text = re.sub(r'\\b[IVXLCDM]+\\b', '', text)\n",
    "    text = re.sub(r'[\\(\\)\\[\\]\\{\\}]', '', text)\n",
    "    text = re.sub(r'\\s+', ' ', text)\n",
    "    text = re.sub(r'[^а-яё\\s\\-]', '', text)\n",
    "    return text.strip()\n",
    "\n",
    "# Функция для лемматизации и кэширования лемм(чтобы далее ускорить обработку)\n",
    "def get_lemma(word: str, cache: dict) -> str:\n",
    "    if word not in cache:\n",
    "        parsed = morph.parse(word)[0]\n",
    "        cache[word] = parsed.normal_form\n",
    "    return cache[word]\n",
    "\n",
    "def lemmatize_text(text: str, cache: dict) -> str:\n",
    "    # Разбиваем на слова, лемматизируем, собираем обратно\n",
    "    words = text.split()\n",
    "    lemmas = [get_lemma(w, cache) for w in words]\n",
    "    return \" \".join(lemmas)"
   ]
  },

   "source": [
    "WORD_COUNT_PER_FRAGMENT = 250\n",
    "\n",
    "def add_local_features(df: pd.DataFrame) -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    Добавляет признаки по цветам. Всё считается по колонке text_lemmatized.\n",
    "    Редкие цвета исключены, так как они почти не встречаются и портят распределение.\n",
    "    \"\"\"\n",
    "    df = df.copy()\n",
    "\n",
    "    def count_in_list(text, color_list):\n",
    "        if not isinstance(text, str):\n",
    "            return 0\n",
    "        words = text.split()\n",
    "        return sum(1 for w in words if w in color_list)\n",
    "    \n",
    "    # Подсчет по группам\n",
    "    df['total_color_tokens'] = df['text_lemmatized'].apply(lambda x: count_in_list(x, all_color_words))\n",
    "    df['warm_count'] = df['text_lemmatized'].apply(lambda x: count_in_list(x, color_groups['warm']))\n",
    "    df['cool_count'] = df['text_lemmatized'].apply(lambda x: count_in_list(x, color_groups['cool']))\n",
    "    df['neutral_count'] = df['text_lemmatized'].apply(lambda x: count_in_list(x, color_groups['neutral']))\n",
    "\n",
    "    # Плотность (на фрагмент 250 слов)\n",
    "    df['density_total'] = df['total_color_tokens'] / WORD_COUNT_PER_FRAGMENT\n",
    "\n",
    "    # Доли внутри найденных цветов (+ защита от деления на 0)\n",
    "    denom = df['total_color_tokens'].clip(lower=1)\n",
    "    df['warm_ratio'] = df['warm_count'] / denom\n",
    "    df['cool_ratio'] = df['cool_count'] / denom\n",
    "    df['neutral_ratio'] = df['neutral_count'] / denom\n",
    "\n",
    "    # Разница тёплых и холодных долей\n",
    "    df['warm_cool_diff'] = df['warm_ratio'] - df['cool_ratio']\n",
    "\n",
    "    # Уникальные цвета в фрагменте\n",
    "    def unique_colors_count(text):\n",
    "        if not isinstance(text, str):\n",
    "            return 0\n",
    "        words = text.split()\n",
    "        return len(set(w for w in words if w in all_color_words))\n",
    "\n",
    "    df['n_unique_colors'] = df['text_lemmatized'].apply(unique_colors_count)\n",
    "\n",
    "    # Бинарные признаки: есть ли цвет / есть ли тёплый / холодный / нейтральный\n",
    "    df['has_any_color'] = (df['total_color_tokens'] > 0).astype(int)\n",
    "    df['has_warm'] = (df['warm_count'] > 0).astype(int)\n",
    "    df['has_cool'] = (df['cool_count'] > 0).astype(int)\n",
    "    df['has_neutral'] = (df['neutral_count'] > 0).astype(int)\n",
    "\n",
    "    return df\n"
   ]
  },

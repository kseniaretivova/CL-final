    "for fold in range(1, n_folds + 1):\n",
    "    print(f\"--- Обработка фолда {fold}/{n_folds} ---\")\n",
    "    \n",
    "    train_path = os.path.join(input_dir, f'train_fold_{fold}.parquet')\n",
    "    test_path = os.path.join(input_dir, f'test_fold_{fold}.parquet')\n",
    "\n",
    "    train = pd.read_parquet(train_path)\n",
    "    test = pd.read_parquet(test_path)\n",
    "    \n",
    "    # Приводим author к строке и убираем пробелы\n",
    "    train['author'] = train['author'].astype(str).str.strip()\n",
    "    test['author'] = test['author'].astype(str).str.strip()\n",
    "    \n",
    "    print(f\"Размер train: {train.shape}, test: {test.shape}\")\n",
    "\n",
    "    # Добавляем признаки\n",
    "    train_feat = add_local_features(train)\n",
    "    test_feat = add_local_features(test)\n",
    "\n",
    "    # Смотрим, что признаки не пустые\n",
    "    feature_cols = [\n",
    "        'has_any_color',\n",
    "        'total_color_tokens',\n",
    "        'n_unique_colors',\n",
    "        'warm_count',\n",
    "        'cool_count',\n",
    "        'neutral_count',\n",
    "        'warm_ratio',\n",

   "source": [
    "feature_cols_0 = [\n",
    "    'has_any_color', 'total_color_tokens', 'n_unique_colors',\n",
    "    'warm_count', 'cool_count', 'neutral_count',\n",
    "    'warm_ratio', 'cool_ratio', 'neutral_ratio',\n",
    "    'warm_cool_diff', 'density_total'\n",
    "]\n",
    "\n",
    "base_estimators = [\n",
    "    ('rf', RandomForestClassifier(\n",
    "        n_estimators=200,\n",
    "        max_depth=8,\n",
    "        min_samples_leaf=7,\n",
    "        class_weight='balanced',\n",
    "        random_state=42,\n",
    "        n_jobs=-1)),\n",
    "    ('gb', HistGradientBoostingClassifier(\n",
    "        max_iter=200,\n",
    "        learning_rate=0.05,\n",
    "        random_state=42))\n",
    "]\n",
    "\n",
    "meta_clf = LogisticRegression(\n",
    "    max_iter=1000,\n",
    "    solver='lbfgs',\n",
    "    class_weight='balanced',\n",
    "        random_state=42\n",
    ")\n",
    "\n",
    "stack = StackingClassifier(\n",
    "    estimators=base_estimators,\n",
    "    final_estimator=meta_clf,\n",
    "    cv=None,\n",
    "    n_jobs=-1\n",
    ")\n",
    "\n",
    "\n",
    "all_metrics = []\n",
    "for val_fold in range(1, n_folds + 1):\n",
    "    train_dfs = []\n",
    "    for f in range(1, n_folds + 1):\n",
    "        if f == val_fold:\n",
    "            continue\n",
    "        path = os.path.join(output_dir, f'train_feat_fold_{f}.parquet')\n",
    "        train_dfs.append(pd.read_parquet(path))\n",
    "    df_train = pd.concat(train_dfs, ignore_index=True)\n",
    "\n",
    "    df_val = pd.read_parquet(os.path.join(output_dir, f'test_feat_fold_{val_fold}.parquet'))\n",
    "\n",
    "    X_train = df_train[feature_cols_0]\n",
    "    y_train = df_train['author']\n",
    "    X_val = df_val[feature_cols_0]\n",
    "    y_val = df_val['author']\n",
    "\n",
    "    stack.fit(X_train, y_train)\n",
    "    y_pred = stack.predict(X_val)\n",
    "\n",
    "    acc = accuracy_score(y_val, y_pred)\n",
    "    f1_macro = f1_score(y_val, y_pred, average='macro', zero_division=0)\n",
    "    all_metrics.append({'fold': val_fold, 'accuracy': acc, 'f1_macro': f1_macro})\n",
    "\n",
    "    print(f\"\\n--- Фолд {val_fold} ---\")\n",
    "    print(f\"Accuracy: {acc:.4f}, F1 macro: {f1_macro:.4f}\")\n",
    "    print(\"Classification report:\")\n",
    "    print(classification_report(y_val, y_pred, zero_division=0))\n",
    "\n",
    "metrics_df = pd.DataFrame(all_metrics)\n",
    "print(\"\\n=== Средние метрики по фолдам ===\")\n",
    "print(metrics_df.mean())"
   ]
  },
